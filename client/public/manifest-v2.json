    }
  ],
  "shortcuts": [
    {
      "name": "مكتبة الأوامر",
      "short_name": "الأوامر",
      "description": "200+ أمر ذكي للمبدعين",
      "url": "/?tab=prompts",
      "icons": [
        {
          "src": "/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "الدليل الاستراتيجي",
      "short_name": "الدليل",
      "description": "دليل شامل للمبدعين",
      "url": "/?tab=guide",
      "icons": [
        {
          "src": "/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "مركز الأفكار",
      "short_name": "الأفكار",
      "description": "5 أفكار جديدة يومياً",
      "url": "/?tab=ideas",
      "icons": [
        {
          "src": "/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/png", "image/jpeg", "image/webp", "video/mp4"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+smartcreator",
      "url": "/?action=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/plain": [".txt"],
        "text/markdown": [".md"],
        "application/json": [".json"]
      },
      "icons": [
        {
          "src": "/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-new", "auto"]
  },
  "prefer_related_applications": false,
  "lang": "ar",
  "dir": "rtl"
}
