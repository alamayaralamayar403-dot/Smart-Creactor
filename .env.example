# ============================================
# Smart Creator System 2026 - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=mysql://user:password@localhost:3306/smart_creator

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
OAUTH_SERVER_URL=https://oauth.example.com
VITE_OAUTH_PORTAL_URL=https://login.example.com
VITE_APP_ID=your_oauth_app_id

# ============================================
# OWNER INFORMATION
# ============================================
OWNER_NAME=Your Name
OWNER_OPEN_ID=your_open_id

# ============================================
# AI & LLM SERVICES
# ============================================
# Manus Built-in LLM API (Server-side)
BUILT_IN_FORGE_API_URL=https://api.manus.im/forge
BUILT_IN_FORGE_API_KEY=your_forge_api_key

# Frontend access to Manus APIs
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im/forge
VITE_FRONTEND_FORGE_API_KEY=your_frontend_forge_api_key

# ============================================
# NOTION INTEGRATION (Optional)
# ============================================
NOTION_API_KEY=your_notion_api_key
NOTION_DATABASE_ID=your_notion_database_id

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password_or_app_token

# ============================================
# STRIPE PAYMENT (Optional)
# ============================================
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# ANALYTICS (Optional)
# ============================================
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your_website_id

# ============================================
# APP BRANDING
# ============================================
VITE_APP_TITLE=Smart Creator System 2026
VITE_APP_LOGO=https://your-domain.com/logo.png

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
NODE_ENV=development
DEBUG=false

# ============================================
# EXTERNAL APIs (Optional)
# ============================================
# OpenAI API (if using directly)
OPENAI_API_KEY=sk_your_openai_key

# Google Maps API (if needed)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Sell App Integration (for product selling)
SELLAPP_API_KEY=your_sellapp_api_key
SELLAPP_WEBHOOK_SECRET=your_sellapp_webhook_secret

# ============================================
# NOTES
# ============================================
# 1. Never commit .env file to version control
# 2. Keep .env.example with placeholder values only
# 3. Database credentials should be strong and unique
# 4. API keys should be rotated regularly
# 5. Use environment-specific values for dev/staging/production
